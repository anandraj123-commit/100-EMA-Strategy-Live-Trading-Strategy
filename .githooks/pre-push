#!/bin/sh

set -eu

while read -r local_ref local_oid remote_ref remote_oid; do

  # Extract branch name from refs/heads/<branch>
  case "$remote_ref" in
    refs/heads/main*|refs/heads/testing*|refs/heads/release*)
      branch="${remote_ref#refs/heads/}"

      echo "ERROR: Direct push to protected branch '$branch' is not allowed."
      echo "Please push your feature/product branch and merge through the approved workflow."

      exit 1
      ;;
  esac

done

echo "Push allowed."