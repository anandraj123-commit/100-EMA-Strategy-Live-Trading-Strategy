{
  "name": "xautusd-delta-nextjs-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"tsx worker.ts\"",
    "build": "next build",
    "start": "concurrently \"next start\" \"tsx worker.ts\"",
    "check-env": "tsx check-env.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "secret:scan": "node --import tsx scripts/scan-secrets.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.7",
    "mongodb": "^6.21.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "csstype": "^3.2.2",
    "typescript": "^5.9.2"
  }
}
