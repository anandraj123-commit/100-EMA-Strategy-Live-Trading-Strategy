{
  "name": "xautusd-delta-nextjs-bot",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <23"
  },
  "scripts": {
    "dev": "concurrently \"next dev\" \"tsx worker.ts\"",
    "build": "next build",
    "start": "concurrently --kill-others-on-fail --names web,runtime \"next start\" \"tsx worker.ts\"",
    "check-env": "tsx check-env.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "secret:scan": "node --import tsx scripts/scan-secrets.ts",
    "diff:check": "git diff --check && git diff --cached --check",
    "validate": "npm test && npm run typecheck && npm run build && npm run secret:scan && npm run diff:check",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "npm run hooks:install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.7",
    "mongodb": "^6.21.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "csstype": "^3.2.2",
    "typescript": "^5.9.2"
  }
}
