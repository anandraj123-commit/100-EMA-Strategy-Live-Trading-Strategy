+
+const row=(source:'bot'|'exchange_existing',gross:number,brokerage:number|null,GST:number|null):TradeDocument=>({tradeId:`${source}-${gross}`,symbol:'XAUTUSD',productId:1,side:'LONG',source,attributionStatus:source==='bot'?'BOT_CONFIRMED':'MANUAL_CONFIRMED',status:'CLOSED',entryTime:new Date(),intendedEntryPrice:100,actualEntryPrice:100,quantity:1,contracts:1,contractValue:1,initialSL:90,takeProfit:120,exitTime:new Date(),intendedExitPrice:100+gross,actualExitPrice:100+gross,exitReason:'UNKNOWN',grossPnL:gross,brokerage,GST,otherCharges:GST==null?null:0,totalCharges:brokerage!=null&&GST!=null?brokerage+GST:null,netPnL:brokerage!=null&&GST!=null?gross-brokerage-GST:null,estimatedBrokerage:null,estimatedGST:null,estimatedTotalCharges:null,estimatedNetPnL:null,realizedR:brokerage!=null&&GST!=null?gross/10:null,entryOrderId:'1',exitOrderId:'2',entryClientOrderId:null,exitClientOrderId:null,entryFillIds:['1'],exitFillIds:['2'],financialStatus:brokerage!=null&&GST!=null?'actual':'partial',feeDataSource:'delta_fills_commission',priceDataSource:'delta_weighted_fills',attributionNote:null,reconciliationError:null,createdAt:new Date(),updatedAt:new Date(),reconciledAt:new Date()});
+
+test('LONG and SHORT gross P/L signs are correct',()=>{assert.equal(grossPnL('LONG',100,110,2),20);assert.equal(grossPnL('LONG',100,90,2),-20);assert.equal(grossPnL('SHORT',100,90,2),20);assert.equal(grossPnL('SHORT',100,110,2),-20);});
+test('weighted fills and actual commission aggregate once',()=>{const fills=[{price:'100',size:1,commission:'0.1'},{price:'110',size:3,commission:'0.2'}];assert.equal(weightedAverage(fills),107.5);assert.ok(Math.abs((aggregateCommission(fills)??0)-0.3)<1e-12);});
+test('actual and estimated charges are never silently mixed',()=>{const value=financials({side:'LONG',entry:100,exit:110,quantity:2,entryFills:[{commission:'0.1'}],exitFills:[{commission:'0.2'}],estimatedBrokerage:0.5,estimatedGST:0.09});assert.equal(value.brokerage,0.30000000000000004);assert.equal(value.GST,null);assert.equal(value.totalCharges,null);assert.equal(value.netPnL,null);assert.equal(value.estimatedTotalCharges,0.59);assert.equal(value.financialStatus,'partial');});
+test('missing financial data does not create fake actual values',()=>{const value=financials({side:'LONG',entry:100,exit:110,quantity:1,entryFills:[],exitFills:[]});assert.equal(value.brokerage,null);assert.equal(value.GST,null);assert.equal(value.netPnL,null);});
