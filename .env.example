DELTA_ENV=demo
DELTA_API_KEY=your_delta_api_key
DELTA_API_SECRET=your_delta_api_secret
SYMBOL=XAUTUSD
RESOLUTION=5m
EMA_LENGTH=100
SLOPE_LOOKBACK=3
RR=8
RISK_PCT=1
RISK_BASE=available
MAX_DAILY_CONSECUTIVE_LOSSES=10
MIN_STOP_PCT=0
MAX_EFFECTIVE_LEVERAGE=100
MAX_FEE_RISK_PCT=20
GST_PCT=18
ORDER_LEVERAGE=100
PRICE_SOURCE=last

# false is the safe default. Change only after demo validation.
AUTO_TRADE=true

# Fast live breakout check.
POLL_MS=1000

# Web dashboard authentication (generate a random secret of at least 32 characters).
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB=trading_dashboard
AUTH_SECRET=generate_a_strong_random_secret
