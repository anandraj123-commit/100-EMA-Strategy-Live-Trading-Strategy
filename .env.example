# Portfolio environments use strictly separate server-side credentials.
DELTA_LIVE_API_KEY=your_live_api_key
DELTA_LIVE_API_SECRET=your_live_api_secret

DELTA_DEMO_API_KEY=your_demo_api_key
DELTA_DEMO_API_SECRET=your_demo_api_secret


RESOLUTION=5m
EMA_LENGTH=100
SLOPE_LOOKBACK=3
ENTRY_VALID_CANDLES=2
RR=8
RISK_PCT=1
RISK_BASE=available
MAX_DAILY_CONSECUTIVE_LOSSES=10
MIN_STOP_PCT=0
MAX_EFFECTIVE_LEVERAGE=100
MAX_FEE_RISK_PCT=20
GST_PCT=18
ORDER_LEVERAGE=100
PRICE_SOURCE=last
AUTO_TRADE=false
POLL_MS=1000



MONGODB_URI=your_mongodb_connection_string
MONGODB_DB=trading_dashboard
AUTH_SECRET=generate_a_secure_random_secret
TRUST_PROXY_IP_HEADERS=false

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=set_a_temporary_admin_password
