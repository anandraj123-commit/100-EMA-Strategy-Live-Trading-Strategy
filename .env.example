# APP_MODE is required and independent of NODE_ENV. Fill only the selected mode.
APP_MODE=development

# DEVELOPMENT
MONGODB_URI_DEVELOPMENT=
MONGODB_DB_DEVELOPMENT=
AUTH_SECRET_DEVELOPMENT=
DELTA_API_KEY_DEVELOPMENT=
DELTA_API_SECRET_DEVELOPMENT=

# TESTING
MONGODB_URI_TESTING=
MONGODB_DB_TESTING=
AUTH_SECRET_TESTING=
DELTA_API_KEY_TESTING=
DELTA_API_SECRET_TESTING=

# PRODUCTION
MONGODB_URI_PRODUCTION=
MONGODB_DB_PRODUCTION=
AUTH_SECRET_PRODUCTION=
DELTA_API_KEY_PRODUCTION=
DELTA_API_SECRET_PRODUCTION=

RESOLUTION=5m
EMA_LENGTH=100
SLOPE_LOOKBACK=3
ENTRY_VALID_CANDLES=2
RR=8
RISK_PCT=1
RISK_BASE=available
MAX_DAILY_CONSECUTIVE_LOSSES=10
MIN_STOP_PCT=0
MAX_EFFECTIVE_LEVERAGE=100
MAX_FEE_RISK_PCT=20
GST_PCT=18
ORDER_LEVERAGE=100
PRICE_SOURCE=last
AUTO_TRADE=false
POLL_MS=1000



# Optional login proxy handling; enable only behind a trusted proxy.
TRUST_PROXY_IP_HEADERS=false
